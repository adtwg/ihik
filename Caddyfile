{
	admin off
	email {$ACME_EMAIL}
}

# Mode VPS full (Opsi 1): Caddy memegang 80/443 dan menerbitkan HTTPS otomatis
# via Let's Encrypt untuk APP_DOMAIN. HTTP di-redirect ke HTTPS otomatis.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stdout
		format console
	}

	@api path /api/* /health /ready /internal/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
